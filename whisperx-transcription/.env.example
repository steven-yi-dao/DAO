# Copy to .env.local. Only needed once the SPA is wired to the backend — it
# still runs on built-in mocks today.
#
# In production Caddy serves the SPA and proxies /api on the same origin, so
# the relative default is correct. Point this at the dev server only when
# running `npm run dev` against a backend on another host.

VITE_API_URL=/api
