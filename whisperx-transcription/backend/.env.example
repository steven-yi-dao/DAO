# Copy to .env next to docker-compose.yml.

# The hostname Caddy provisions a certificate for. Must already resolve to the
# instance's Elastic IP, or the ACME challenge fails on first start.
# Use `localhost` for local development (Caddy issues a local CA cert).
DOMAIN=transcribe.example.edu

# Host path mounted at /data in both Python containers. On EC2 this is the
# separate encrypted EBS volume, never the instance's local NVMe.
DATA_DIR=/data

MAX_UPLOAD_BYTES=524288000
RETENTION_DAYS=7
WHISPER_MODEL=medium
