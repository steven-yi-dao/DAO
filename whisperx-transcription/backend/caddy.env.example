# Copy to caddy.env and fill in. Never commit the real file.
#
# Generate the hash (the plaintext never needs to leave your machine):
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password'
#
# or, without docker:
#
#   htpasswd -bnBC 12 "" 'the-password' | tr -d ':\n'
#
# On the server the real file lives at /data/caddy.env, on the encrypted volume
# that survives instance replacement, and user-data.sh copies it into place at
# boot. Edit it there, not here, or the next rebuild reverts you.

BASIC_AUTH_USER=dao
BASIC_AUTH_HASH=$2y$12$replace-with-a-real-bcrypt-hash
