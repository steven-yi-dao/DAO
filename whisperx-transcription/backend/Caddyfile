{$DOMAIN} {
	encode gzip

	# One shared credential in front of everything, SPA and API alike. The API
	# has no accounts and no owner column, so anyone who reaches it can list
	# every job, read any transcript, and delete any of them. This is a door,
	# not per-user separation.
	#
	# Covers /api/* too, which the browser handles for free: it caches the
	# credential from the initial page challenge and attaches it to the SPA's
	# same-origin polling and uploads without any client-side change.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# Must exceed the API's MAX_UPLOAD_BYTES, or Caddy rejects the upload before
	# FastAPI can return its own "File too large" message.
	request_body {
		max_size 512MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# A 500 MB upload over a slow link can take a while; don't cut it off.
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}

	# SPA fallback: unknown paths render index.html so client routing works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
